# ---------------------------------------------------------------------------
# Intelligent Text Analysis System - example environment file
# Copy to .env and adjust. Never commit the real .env file.
# ---------------------------------------------------------------------------

FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret

# --- Database ---------------------------------------------------------------
# Production / academic submission: MySQL 8+ (PyMySQL driver)
# DATABASE_URL=mysql+pymysql://ita_user:strong-password@127.0.0.1:3306/ita_db?charset=utf8mb4
#
# Zero-configuration local fallback (SQLite). Remove the # on the next line to
# deliberately use MySQL instead.
DATABASE_URL=sqlite:///ita_dev.db

# --- Session / security -----------------------------------------------------
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax
PERMANENT_SESSION_LIFETIME_HOURS=8
MAX_CONTENT_LENGTH_MB=10
MAX_TEXT_LENGTH=50000
RATELIMIT_ENABLED=true

# --- NLP models -------------------------------------------------------------
# Abstractive summarisation (Hugging Face). ~1.2 GB download on first use.
SUMMARIZATION_MODEL=sshleifer/distilbart-cnn-12-6
# Local explanation model (Hugging Face). Used when no API key is configured.
EXPLANATION_MODEL=google/flan-t5-base
# Optional multilingual sentiment model (leave empty to use VADER only).
MULTILINGUAL_SENTIMENT_MODEL=
# Hugging Face cache directory (optional)
# HF_HOME=C:/Users/you/.cache/huggingface

# --- Explanation provider ---------------------------------------------------
# local  = pretrained Hugging Face model (works offline after download)
# openai = any OpenAI-compatible chat completions API
EXPLANATION_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Translation ------------------------------------------------------------
# mymemory      = free public API, no key (rate limited; good for a demo)
# libretranslate= self-hosted or hosted LibreTranslate instance
# openai        = OpenAI-compatible chat model
# local         = Helsinki-NLP MarianMT model downloaded on demand
TRANSLATION_PROVIDER=mymemory
MYMEMORY_EMAIL=
LIBRETRANSLATE_URL=https://libretranslate.com
LIBRETRANSLATE_API_KEY=
TRANSLATION_OPENAI_MODEL=gpt-4o-mini

# --- Uploads ----------------------------------------------------------------
# Uploaded originals are extracted in memory and are NOT persisted.
UPLOAD_MAX_MB=10
